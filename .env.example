# Supabase — get from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — email sending service (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── App URL (required for OAuth + magic link) ───
# Used as the redirect base URL in Supabase auth flows.
# In production: https://yourdomain.com
# In development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────
# Configure in Supabase Dashboard:
#   Authentication → Providers → Google
#   Enter your Google Cloud Console
#   OAuth 2.0 Client ID and Secret there.
# Add this to Google Cloud Console
#   Authorised redirect URIs:
#   https://<your-supabase-project>.supabase.co/auth/v1/callback
# No additional env vars needed here —
# Google credentials live in Supabase dashboard only.

# Upstash Redis — rate limiting
# Create free database at upstash.com
# Copy REST URL and token from dashboard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
