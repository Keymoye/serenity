sequenceDiagram
    participant Customer as Customer (UI)
    participant BookingUI as BookingWizard<br/>(React Component)
    participant API as API Routes<br/>(/api/booking/*)
    participant BookingSvc as booking.service
    participant TimeSlotRepo as timeSlotRepo
    participant BookingRepo as bookingRepo
    participant Supabase as Supabase<br/>(PostgreSQL)

    rect rgb(200, 220, 240)
        Note over Customer,Supabase: Step 1: GET Availability
        Customer->>BookingUI: Select service, therapist, date
        BookingUI->>API: POST /api/booking/availability<br/>{ serviceId, therapistId, date }
        API->>BookingSvc: getAvailability(input)
        Note over BookingSvc: Verify therapist<br/>assigned to service
        BookingSvc->>TimeSlotRepo: Check service-therapist link
        TimeSlotRepo->>Supabase: Query therapist_service table
        Supabase-->>TimeSlotRepo: Assignment verified
        BookingSvc->>TimeSlotRepo: findForTherapistOnDate(therapistId, dateRange)
        TimeSlotRepo->>Supabase: SELECT time_slots WHERE therapist_id=? AND date BETWEEN ? AND ?
        Supabase-->>TimeSlotRepo: Return slots
        TimeSlotRepo-->>BookingSvc: Filter is_available=true, locked_until expired
        BookingSvc-->>API: Return available slots
        API-->>BookingUI: 200 OK { slots: [...] }
        BookingUI-->>Customer: Display available time slots
    end

    rect rgb(220, 240, 200)
        Note over Customer,Supabase: Step 2: LOCK Slot (optional pre-confirmation)
        Customer->>BookingUI: Select time slot
        BookingUI->>API: POST /api/booking/lock<br/>{ timeSlotId }
        API->>BookingSvc: lockSlot(timeSlotId)
        Note over BookingSvc: Set locked_until<br/>to now + 10 minutes
        BookingSvc->>TimeSlotRepo: lockSlot(id, lockUntil, now)
        TimeSlotRepo->>Supabase: UPDATE time_slots WHERE id=? AND locked_until IS NULL<br/>SET locked_until = locked_until
        alt Slot Successfully Locked
            Supabase-->>TimeSlotRepo: 1 row updated
            TimeSlotRepo-->>BookingSvc: true
            BookingSvc-->>API: Success (void)
            API-->>BookingUI: 200 OK
        else Slot Already Locked
            Supabase-->>TimeSlotRepo: 0 rows updated
            TimeSlotRepo-->>BookingSvc: false
            BookingSvc-->>API: throw ConflictError(SLOT_TAKEN)
            API-->>BookingUI: 409 Conflict
            BookingUI-->>Customer: ⚠️ Slot taken. Try another.
        end
    end

    rect rgb(240, 200, 200)
        Note over Customer,Supabase: Step 3: CONFIRM Booking (Atomic)
        Customer->>BookingUI: Confirm booking with details
        BookingUI->>API: POST /api/booking/confirm<br/>{ serviceId, therapistId, timeSlotId, notes }
        API->>BookingSvc: confirmBooking(payload, context)
        Note over BookingSvc: Generate reference code<br/>(format: SS-YYMMDD-XXXXX)
        BookingSvc->>TimeSlotRepo: tryMarkAsBooked(timeSlotId)
        Note over TimeSlotRepo: ATOMIC: UPDATE time_slots<br/>WHERE id=? AND is_available=true<br/>SET is_available=false
        TimeSlotRepo->>Supabase: Atomic WHERE clause + SET
        alt Slot Marked Successfully
            Supabase-->>TimeSlotRepo: 1 row updated
            TimeSlotRepo-->>BookingSvc: true
            BookingSvc->>BookingRepo: createBooking({ customer_id, service_id, therapist_id, time_slot_id, status=confirmed, reference_code, notes })
            BookingRepo->>Supabase: INSERT INTO bookings (...)
            Supabase-->>BookingRepo: Booking created with id
            BookingRepo-->>BookingSvc: Booking object
            BookingSvc-->>API: { booking, referenceCode }
            API-->>BookingUI: 200 OK
            BookingUI-->>Customer: ✅ Booking confirmed!<br/>Reference: SS-260305-XXXXX
            Customer->>BookingUI: Go to /dashboard
        else Double-Booked (Another request won race)
            Supabase-->>TimeSlotRepo: 0 rows updated
            TimeSlotRepo-->>BookingSvc: false
            BookingSvc-->>API: throw ConflictError(SLOT_ALREADY_BOOKED)
            API-->>BookingUI: 409 Conflict
            BookingUI-->>Customer: ❌ Slot just booked by<br/>another customer
        else Booking Insert Fails
            BookingRepo-->>BookingSvc: Error
            Note over BookingSvc: Attempt rollback:<br/>SET is_available=true
            BookingSvc->>TimeSlotRepo: setAvailable(timeSlotId)
            TimeSlotRepo->>Supabase: UPDATE time_slots SET is_available=true
            Supabase-->>TimeSlotRepo: Updated (best-effort)
            BookingSvc-->>API: throw InternalError(INSERT_FAILED)
            API-->>BookingUI: 500 Internal Error
        end
    end
