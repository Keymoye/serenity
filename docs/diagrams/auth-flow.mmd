sequenceDiagram
    participant User as User (Browser)
    participant UI as UI Components<br/>(auth pages)
    participant API as API Routes<br/>(/api/auth/*)
    participant AuthSvc as auth.service
    participant AuthRepo as authRepo<br/>(Supabase Auth)
    participant Supabase as Supabase

    rect rgb(200, 220, 240)
        Note over User,Supabase: LOGIN FLOW
        User->>UI: Enter email & password
        UI->>API: POST /api/auth/login<br/>{ email, password }
        Note over API: Validate input with<br/>loginSchema (Zod)
        alt Schema validation fails
            API-->>UI: 400 VALIDATION_ERROR
            UI-->>User: Show validation error
        else Schema OK
            API->>AuthSvc: login({ email, password })
            AuthSvc->>AuthRepo: signInWithPassword(email, password)
            AuthRepo->>Supabase: Supabase Auth API<br/>(verify credentials)
            alt Credentials valid
                Supabase-->>AuthRepo: Session token + user info
                AuthRepo-->>AuthSvc: Success
                AuthSvc-->>API: void (no error)
                API-->>UI: 200 OK { success: true }
                UI->>User: Set session cookie<br/>Redirect to /dashboard
            else Credentials invalid
                Supabase-->>AuthRepo: Auth error
                AuthRepo-->>AuthSvc: Throws error
                AuthSvc-->>API: InternalError(LOGIN_FAILED)
                API-->>UI: 500 (mapped from domain error)
                UI-->>User: ❌ Invalid email or password
            end
        end
    end

    rect rgb(220, 240, 200)
        Note over User,Supabase: REGISTER FLOW
        User->>UI: Enter email, password, name, phone
        UI->>API: POST /api/auth/register<br/>{ email, password, confirmPassword, name, phone }
        Note over API: Validate with registerSchema<br/>(.refine password match)
        alt Schema validation fails
            API-->>UI: 400 VALIDATION_ERROR
            UI-->>User: Show field errors
        else Schema OK
            API->>AuthSvc: register({ email, password, name, phone })
            AuthSvc->>AuthRepo: signUp(email, password,<br/>{ data: { name, phone } })
            AuthRepo->>Supabase: Create user + set metadata
            alt User created successfully
                Supabase-->>AuthRepo: User ID + requiresEmailConfirmation
                AuthRepo-->>AuthSvc: { requiresEmailConfirmation: boolean }
                AuthSvc-->>API: Return result
                API-->>UI: 200 OK { success: true, requiresEmailConfirmation }
                alt Email confirmation required
                    UI-->>User: ✅ Account created!<br/>Check email for verification
                else Email auto-confirmed
                    UI-->>User: ✅ Account created!<br/>Ready to log in
                end
            else User already exists or other error
                Supabase-->>AuthRepo: Error
                AuthRepo-->>AuthSvc: Throws error
                AuthSvc-->>API: InternalError(REGISTER_FAILED)
                API-->>UI: 500
                UI-->>User: ❌ Registration failed
            end
        end
    end

    rect rgb(240, 200, 200)
        Note over User,Supabase: PASSWORD RESET FLOW
        User->>UI: Enter email on forget-password page
        UI->>API: POST /api/auth/reset-password<br/>{ email, redirectTo? }
        Note over API: Validate with<br/>resetPasswordRequestSchema
        alt Schema fails
            API-->>UI: 400 VALIDATION_ERROR
        else Schema OK
            API->>AuthSvc: requestPasswordReset({ email, redirectTo })
            AuthSvc->>AuthRepo: resetPasswordForEmail(email, redirectTo)
            AuthRepo->>Supabase: Send reset email<br/>with token link
            Supabase->>User: Email arrives with<br/>reset link (token in query)
            AuthRepo-->>AuthSvc: Success
            AuthSvc-->>API: void
            API-->>UI: 200 OK { success: true }
            UI-->>User: ✅ Check email for reset link
        end

        Note over User,UI: User clicks link in email
        User->>UI: Open reset link<br/>/reset?token=...
        UI->>UI: Extract access_token<br/>& refresh_token from URL
        
        User->>UI: Enter new password
        UI->>API: POST /api/auth/reset-password/confirm<br/>{ access_token, refresh_token, password }
        Note over API: Validate tokens & password<br/>length, format
        alt Validation fails
            API-->>UI: 400 VALIDATION_ERROR
            UI-->>User: Show error
        else Validation OK
            API->>AuthSvc: confirmPasswordRecovery({<br/>accessToken, refreshToken, password })
            AuthSvc->>AuthRepo: setSession(accessToken, refreshToken)
            AuthRepo->>Supabase: Set user session
            Supabase-->>AuthRepo: Session active
            AuthSvc->>AuthRepo: updatePassword(password)
            AuthRepo->>Supabase: Update user password hash
            Supabase-->>AuthRepo: Password updated
            AuthRepo-->>AuthSvc: Success
            AuthSvc-->>API: void
            API-->>UI: 200 OK { success: true }
            UI-->>User: ✅ Password reset!<br/>Redirect to /login
        end
    end
